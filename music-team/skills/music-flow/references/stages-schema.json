{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "music-flow stages.yml",
  "description": "Checked by music-team/scripts/validate_stages.py (stdlib subset: $ref to #/definitions, type, enum, required, properties, additionalProperties, items, minItems, maxItems, pattern, minimum, maximum).",
  "type": "object",
  "required": ["schema_version", "stages", "matrix"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "enum": [1] },
    "stages": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/stage" }
    },
    "matrix": {
      "type": "object",
      "required": ["FULL_SONG", "LYRICS_ONLY", "INSTRUMENTAL", "TOPLINE", "THEORY", "ADAPT_GENRE", "AUGMENT_LYRICS", "REWRITE", "JINGLE", "REVISE", "PARODY_ADAPT"],
      "additionalProperties": false,
      "properties": {
        "FULL_SONG": { "$ref": "#/definitions/row" },
        "LYRICS_ONLY": { "$ref": "#/definitions/row" },
        "INSTRUMENTAL": { "$ref": "#/definitions/row" },
        "TOPLINE": { "$ref": "#/definitions/row" },
        "THEORY": { "$ref": "#/definitions/row" },
        "ADAPT_GENRE": { "$ref": "#/definitions/row" },
        "AUGMENT_LYRICS": { "$ref": "#/definitions/row" },
        "REWRITE": { "$ref": "#/definitions/row" },
        "JINGLE": { "$ref": "#/definitions/row" },
        "REVISE": { "$ref": "#/definitions/row" },
        "PARODY_ADAPT": { "$ref": "#/definitions/row" }
      }
    }
  },
  "definitions": {
    "row": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": { "type": "string" }
    },
    "stringList": { "type": "array", "items": { "type": "string" } },
    "songType": {
      "type": "string",
      "enum": ["FULL_SONG", "LYRICS_ONLY", "INSTRUMENTAL", "TOPLINE", "THEORY", "ADAPT_GENRE", "AUGMENT_LYRICS", "REWRITE", "JINGLE", "REVISE", "PARODY_ADAPT"]
    },
    "stage": {
      "type": "object",
      "required": ["number", "name", "matrix_column", "primary_skill", "dispatch", "agent", "role", "task_type", "gates", "critic_role", "max_loops_key", "input_artifacts", "output_artifacts", "sub_flow"],
      "additionalProperties": false,
      "properties": {
        "number": { "type": "integer", "minimum": 1, "maximum": 7 },
        "name": { "type": "string" },
        "matrix_column": { "type": "integer", "minimum": 1, "maximum": 7 },
        "primary_skill": { "type": "string", "pattern": "^[a-z][a-z-]*$" },
        "dispatch": { "type": "string", "enum": ["agent", "skill"] },
        "agent": { "type": ["string", "null"], "pattern": "^[a-z][a-z-]*$" },
        "role": { "type": "string", "pattern": "^[a-z][a-z-]*$" },
        "then_roles": { "$ref": "#/definitions/stringList" },
        "task_type": { "type": "string", "pattern": "^[a-z][a-z-]*$" },
        "gates": { "$ref": "#/definitions/stringList" },
        "critic_role": { "type": ["string", "null"] },
        "critic_agent": { "type": ["string", "null"] },
        "max_loops_key": { "type": ["string", "null"], "enum": ["concept", "structure", "lyrics", "music", "arrangement", "release", null] },
        "input_artifacts": { "$ref": "#/definitions/stringList" },
        "output_artifacts": { "$ref": "#/definitions/stringList" },
        "sub_flow": { "type": "string", "pattern": "^stages/[0-9]{2}-[a-z-]+\\.md$" },
        "only_types": { "type": "array", "items": { "$ref": "#/definitions/songType" } },
        "runs_on_cells": { "type": "array", "items": { "type": "string", "enum": ["F", "L", "I"] } },
        "blocker_return": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 7 } },
        "notes": { "type": "string" },
        "type_variants": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/variant" }
        }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dispatch": { "type": "string", "enum": ["agent", "skill"] },
        "primary_skill": { "type": "string", "pattern": "^[a-z][a-z-]*$" },
        "agent": { "type": ["string", "null"], "pattern": "^[a-z][a-z-]*$" },
        "role": { "type": "string", "pattern": "^[a-z][a-z-]*$" },
        "then_roles": { "$ref": "#/definitions/stringList" },
        "task_type": { "type": "string", "pattern": "^[a-z][a-z-]*$" },
        "output_artifacts": { "$ref": "#/definitions/stringList" }
      }
    }
  }
}
