          "collaboration_patterns": ["consensus", "adversarial_review"],
          "max_iterations": 3,
          "scope_constraint": null
        },
        "development": {
          "depth": "full",
          "dod_validators": ["developer", "qa_engineer", "architect", "technical_writer", "security"],
          "collaboration_patterns": ["evaluator_optimizer", "decision_ownership", "adversarial_review"],
          "max_iterations": 3,
