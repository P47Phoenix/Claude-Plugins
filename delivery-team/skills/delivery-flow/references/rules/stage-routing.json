  "collaboration_pattern_definitions": {
    "evaluator_optimizer": {
      "description": "Baseline quality pass. One agent produces, another evaluates, feedback loops until pass or max iterations.",
      "execution_order": 1
    },
    "adversarial_review": {
      "description": "Stress-test assumptions. Challenger questions decisions, identifies missing edge cases, rates confidence 1-5. If confidence <= 2, escalate to human.",
      "execution_order": 2
    },
    "debate": {
      "description": "Resolve contested decisions. PRO and CON agents argue options, JUDGE decides with documented rationale. Produces an ADR. If DEADLOCK, escalate to human.",
      "execution_order": 3
    },
    "multi_perspective_review_board": {
      "description": "Multi-domain assessment. Multiple reviewers evaluate from different perspectives (technical, business, risk). Any BLOCK must be resolved via decision_ownership before advancing.",
      "execution_order": 4
    },
    "consensus": {
      "description": "Cross-team alignment. Multiple roles independently analyze, share positions, respond to disagreements, and converge. 2-3 rounds.",
      "execution_order": 5
    },
    "decision_ownership": {
      "description": "Routing mechanism (not sequenced). Routes domain-specific questions to the appropriate owner: scope -> PO, technical -> Architect, quality -> QA. Can trigger at ANY point.",
      "execution_order": null
    }
  },
