          "collaboration_patterns": [],
          "max_iterations": 2,
          "scope_constraint": "Core user flows and primary screen wireframes only. Skip component specs and design system. Accessibility review limited to critical paths."
        },
        "architect": {
          "depth": "light",
          "dod_validators": ["architect", "qa_engineer"],
          "collaboration_patterns": ["evaluator_optimizer"],
          "max_iterations": 2,
          "scope_constraint": "High-level system design and key ADRs only. Skip detailed C4 diagrams beyond context level. Security review limited to authentication and data protection."
        },
        "plan": {
          "depth": "light",
          "dod_validators": ["scrum_bag", "product_owner"],
