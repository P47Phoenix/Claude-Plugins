          "dod_validators": ["ux_designer", "product_owner", "qa_engineer", "architect"],
          "collaboration_patterns": ["multi_perspective_review_board"],
          "max_iterations": 3,
          "scope_constraint": null
        },
        "architect": {
          "depth": "light",
          "dod_validators": ["architect", "qa_engineer"],
          "collaboration_patterns": ["evaluator_optimizer"],
          "max_iterations": 2,
          "scope_constraint": "Apply full if feature involves new APIs, new data models, external integrations, security-sensitive changes, or touches more than 3 modules. Apply skip if UI-only, single module, no new data models, no security implications, no new external dependencies.",
          "conditional_depth": {
            "full_when": {
              "any_of": [
                {"field": "project.involves_new_apis", "operator": "==", "value": true},
                {"field": "project.involves_new_data_models", "operator": "==", "value": true},
                {"field": "project.has_external_integrations", "operator": "==", "value": true},
                {"field": "project.is_security_sensitive", "operator": "==", "value": true},
                {"field": "project.modules_touched", "operator": ">", "value": 3}
              ]
            },
            "skip_when": {
              "all_of": [
                {"field": "project.is_ui_only", "operator": "==", "value": true},
                {"field": "project.modules_touched", "operator": "<=", "value": 1},
                {"field": "project.involves_new_data_models", "operator": "==", "value": false},
                {"field": "project.is_security_sensitive", "operator": "==", "value": false},
                {"field": "project.has_external_integrations", "operator": "==", "value": false}
              ]
            },
            "default": "light"
          }
        },
        "plan": {
          "depth": "full",
          "dod_validators": ["scrum_bag", "product_owner", "qa_engineer", "devops"],
          "collaboration_patterns": ["consensus", "adversarial_review"],
          "max_iterations": 2,
          "scope_constraint": null
