{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "1.0.0",
  "description": "Routing Decision Specification — normative source of truth for all pipeline routing decisions. Encodes the complete routing matrix: 6 project types × 7 stages × 3 risk tolerances = 126 cells. Each cell defines stage depth, DoD validators, collaboration patterns, and max iterations. Approved by PO (Gandalf) on 2026-03-28.",
  "traces_to": ["PRD FR-03", "PRD FR-15", "PRD FR-18", "US-02", "US-05"],
  "depth_definitions": {
    "full": "All agents invoked, all collaboration patterns run, full quality gate with all severity levels, full team DoD validation.",
    "light": "Primary agent only, blocking criteria only, reduced DoD (primary + 1 reviewer). No adversarial review or debate.",
    "skip": "Stage does not execute. Pipeline advances to next active stage. Downstream stages receive whatever upstream artifacts are available.",
    "full+game": "Everything in full, plus game-specific augmentations (game UI review at Design, game architecture roles at Architect, engine skill at Dev, playtest scenarios at UAT)."
  },
  "risk_tolerance_definitions": {
    "standard": "Default risk profile. Matches the SKILL.md Stage Routing Matrix baseline. Balanced between thoroughness and velocity.",
    "solo": "Prototype/solo developer profile. Fewer validators, fewer collaboration patterns, faster iteration. Warnings are non-blocking.",
    "strict": "Enterprise/compliance profile. More validators, more collaboration patterns, warnings become blocking. No Layer 4 runtime overrides."
  },
  "stages": [
    {"number": 1, "name": "Idea", "id": "idea"},
    {"number": 2, "name": "Refine", "id": "refine"},
    {"number": 3, "name": "Design", "id": "design"},
    {"number": 4, "name": "Architect", "id": "architect"},
    {"number": 5, "name": "Plan", "id": "plan"},
    {"number": 6, "name": "Development", "id": "development"},
    {"number": 7, "name": "UAT", "id": "uat"}
  ],
  "project_types": ["GREENFIELD", "FEATURE", "BUG_FIX", "GAME_DEV", "SPIKE", "DOCS_ONLY"],
  "risk_tolerances": ["standard", "solo", "strict"],
  "routing": {
    "GREENFIELD": {
      "standard": {
        "idea": {
          "depth": "full",
          "dod_validators": ["product_owner", "architect"],
          "collaboration_patterns": [],
          "max_iterations": 2,
          "scope_constraint": null
        },
        "refine": {
          "depth": "full",
          "dod_validators": ["product_owner", "architect", "qa_engineer"],
          "collaboration_patterns": ["evaluator_optimizer", "adversarial_review"],
          "max_iterations": 3,
          "scope_constraint": null
        },
        "design": {
          "depth": "full",
          "dod_validators": ["ux_designer", "product_owner", "qa_engineer", "architect"],
          "collaboration_patterns": ["multi_perspective_review_board"],
          "max_iterations": 3,
          "scope_constraint": null
        },
        "architect": {
          "depth": "full",
          "dod_validators": ["architect", "qa_engineer", "devops", "security"],
          "collaboration_patterns": ["debate", "evaluator_optimizer", "adversarial_review"],
          "max_iterations": 2,
          "scope_constraint": null
        },
        "plan": {
          "depth": "full",
          "dod_validators": ["scrum_bag", "product_owner", "qa_engineer", "devops"],
          "collaboration_patterns": ["consensus", "adversarial_review"],
          "max_iterations": 2,
          "scope_constraint": null
        },
        "development": {
          "depth": "full",
          "dod_validators": ["developer", "qa_engineer", "architect", "technical_writer"],
          "collaboration_patterns": ["evaluator_optimizer", "decision_ownership"],
          "max_iterations": 3,
          "scope_constraint": null
        },
        "uat": {
